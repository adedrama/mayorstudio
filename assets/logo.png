<svg width="1200" height="420" viewBox="0 0 1200 420" fill="none" xmlns="http://www.w3.org/2000/svg">
  
  <!-- Fondo transparente -->
  
  <!-- Icono -->
  <g transform="translate(40,40)">
    
    <!-- Triángulo rojo -->
    <polygon points="180,0 290,110 290,270 180,270 70,160"
      fill="url(#redGradient)"/>

    <!-- Flecha amarilla -->
    <polygon points="55,0 185,130 125,190 55,120"
      fill="url(#yellowGradient)"/>

    <!-- Corte inferior -->
    <polygon points="90,230 140,180 180,220 130,270"
      fill="url(#redGradient2)"/>

  </g>

  <!-- Texto MAYOR -->
  <text x="430" y="180"
    font-family="Montserrat, Arial, sans-serif"
    font-size="140"
    font-weight="800"
    letter-spacing="2"
    fill="url(#textGradient)">
    MAYOR
  </text>

  <!-- Texto STUDIO -->
  <text x="435" y="300"
    font-family="Montserrat, Arial, sans-serif"
    font-size="90"
    font-weight="500"
    letter-spacing="12"
    fill="url(#textGradient)">
    STUDIO
  </text>

  <!-- Gradientes -->
  <defs>

    <linearGradient id="yellowGradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFD000"/>
      <stop offset="100%" stop-color="#FF9A00"/>
    </linearGradient>

    <linearGradient id="redGradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FF5A36"/>
      <stop offset="100%" stop-color="#E6003A"/>
    </linearGradient>

    <linearGradient id="redGradient2" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FF3A4D"/>
      <stop offset="100%" stop-color="#D1002F"/>
    </linearGradient>

    <linearGradient id="textGradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1E2230"/>
      <stop offset="100%" stop-color="#05070D"/>
    </linearGradient>

  </defs>

</svg>
